{
  "name": "decodex",
  "private": true,
  "version": "0.0.0",
  "description": "Root workspace helpers for the Decodex monorepo.",
  "license": "UNLICENSED",
  "scripts": {
    "install": "npm run skills:install",
    "install:all": "npm run skills:install && npm --prefix backend install && npm --prefix frontend install",
    "skills:install": "npx --yes skills experimental_install -y",
    "skills:list": "npx --yes skills list --json",
    "skills:sync:npm": "npx --yes skills experimental_sync --agent codex cursor -y",
    "skills:update": "npx --yes skills update --project -y"
  },
  "dependencies": {
    "autoskills": "^0.3.6"
  }
}
