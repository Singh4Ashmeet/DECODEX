[TEMPLATE]
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/decodex
REDIS_URL=redis://localhost:6379
# REQUIRED — must be a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
SESSION_SECRET=
# REQUIRED — 32-byte base64 string for AES-256-GCM encryption
PII_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
# Optional: Set to true in production to seed initial passages and demo users
SEED_DEMO_DATA=true
OPENAI_API_KEY=sk-your-key-here
# Optional Free-Tier Alternative API (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=gsk-your-key-here
# Optional Sentry DSN for error tracking — errors won't be reported without it
SENTRY_DSN=

# Email delivery via Resend (https://resend.com) — free tier: 3k emails/month
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
# Optional: override the From address (default: Decodex <onboarding@resend.dev>)
# EMAIL_FROM=Decodex <noreply@yourdomain.com>

# Audio Object Storage (V5)
# Provider: 'local' (default, disk) or 'supabase'
AUDIO_STORAGE_PROVIDER=local
# Local disk storage path (default: ./audio-storage relative to backend)
AUDIO_STORAGE_PATH=./audio-storage
# Supabase Storage bucket name (used when provider=supabase or auto-detected)
AUDIO_STORAGE_BUCKET=decodex-audio
# Supabase credentials (required for Supabase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
