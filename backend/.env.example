PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/decodex
REDIS_URL=redis://localhost:6379
# REQUIRED — must be a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=sk-your-key-here
# Optional Free-Tier Alternative API (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=gsk-your-key-here
# Optional Sentry DSN for error tracking — errors won't be reported without it
SENTRY_DSN=
# Use a Google App Password, not your normal Google account password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password

# Audio Object Storage (V5)
# Provider: 'local' (default, disk) or 'supabase'
AUDIO_STORAGE_PROVIDER=local
# Local disk storage path (default: ./audio-storage relative to backend)
AUDIO_STORAGE_PATH=./audio-storage
# Supabase Storage bucket name (used when provider=supabase or auto-detected)
AUDIO_STORAGE_BUCKET=decodex-audio
# Supabase credentials (required for Supabase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
